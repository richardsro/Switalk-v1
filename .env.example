# --- Supabase (free tier) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta (Instagram DM, Facebook Messenger, WhatsApp Cloud API — free) ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=any-random-string-you-choose

# --- Telegram Bot API (free) ----------------------------------------------
TELEGRAM_WEBHOOK_SECRET=any-random-string-you-choose

# --- Resend (free: 3k emails/mo) -------------------------------------------
RESEND_API_KEY=
# Shared secret your inbound-email forwarder must send as x-webhook-secret
EMAIL_WEBHOOK_SECRET=any-random-string-you-choose
# Verified sender identity for users' outbound email replies
# (Resend rejects unverified domains; Reply-To carries the user's address)
EMAIL_FROM="Switalk <replies@switalk.com>"
# Sender for system notifications (follow-up reminder nudges)
SYSTEM_EMAIL_FROM="Switalk <hello@switalk.com>"
# Inbound address users auto-forward their mailbox to; the forwarder behind
# it POSTs to /api/webhooks/email. Shown in Settings -> Channels.
NEXT_PUBLIC_EMAIL_FORWARD_ADDRESS=inbox@switalk.com

# --- Inngest (free tier) ----------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_LITE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
